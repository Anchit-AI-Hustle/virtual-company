{
  "buildCommand": "cd .. && node scripts/build-hq.js",
  "outputDirectory": "public",
  "ignoreCommand": "bash ../scripts/vercel-ignore.sh . ':(exclude)public/data.json' ../scripts/build-hq.js",
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
